# Copy to .env and fill in. Every integration is optional: without a key the app uses its fallback path.

PORT=8787

# Claude: questions and content evaluation
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Only if your key is not scoped to a workspace (error: "must include the anthropic-workspace-id header")
ANTHROPIC_WORKSPACE_ID=
# Evaluation judge: fast model for background segments, stronger model for the streamed final merge
EVAL_SEGMENT_MODEL=claude-haiku-5-5
EVAL_FINAL_MODEL=claude-sonnet-5-5
# "See yourself do it better": fal lip-sync model (photo + audio -> talking video)
EVAL_LIPSYNC_MODEL=minimax/h3-max/lip-sync/image-to-video

# ElevenLabs: live transcript (Scribe realtime), accurate transcript (Scribe batch) and the panelist voice agent
ELEVENLABS_API_KEY=
# Created by `npm run create-agent`
ELEVENLABS_AGENT_ID=

# Anam: the live main avatar (the decision-maker), driven by text we supply.
ANAM_API_KEY=
# Optional: defaults to the first avatar and English voice on the account (see GET /api/avatar/anam-options)
ANAM_AVATAR_ID=
ANAM_VOICE_ID=

# fal: generated backdrops, portraits and reaction clips
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/flux/schnell
FAL_VIDEO_MODEL=bytedance/seedance-2.0/fast/image-to-video

# Synthesia: a stock avatar face and a short spoken intro clip per panelist (needs API access, Pro plan or above)
SYNTHESIA_API_KEY=
# true renders free, watermarked test videos (30 per day)
SYNTHESIA_TEST=

# Interactive panel: fast model for the agents' background drafts (needs ANTHROPIC_API_KEY; without it the agents use built-in lines)
AGENTS_MODEL=claude-haiku-5-5
